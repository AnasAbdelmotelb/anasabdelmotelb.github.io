---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const navLinks = [
  { href: '/#about', label: 'About' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#writing', label: 'Writing' },
  { href: '/dns/', label: 'DNS' },
  { href: '/#contact', label: 'Contact' },
];

const linkedIn = 'https://www.linkedin.com/in/anas-mansour-b17302251/';
const gitHub = 'https://github.com/AnasAbdelmotelb';
const booking = 'https://cal.com/anas-mansour/intro-call';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">Anas Mansour</a>
        <nav aria-label="Main">
          <ul class="nav-list">
            {navLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="nav-cv" href="/cv.pdf">CV</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>&copy; {new Date().getFullYear()} Anas Mansour</p>
        <ul class="footer-links">
          <li>
            <a href={linkedIn} rel="me noopener" target="_blank">
              LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a href={gitHub} rel="me noopener" target="_blank">
              GitHub<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
          <li><a href="/cv.pdf">CV (PDF)</a></li>
          <li>
            <a href={booking} rel="noopener noreferrer" target="_blank">
              Book a Call<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
        </ul>
        <p class="footer-note">Built with Astro and hosted on GitHub Pages.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7faf9;
    --surface: #ffffff;
    --border: #d9e4e1;
    --text: #0f2a26;
    --muted: #5b6b68;
    --accent: #1f7a5c;
    --accent-soft: #e3f2ec;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c1614;
      --surface: #12201d;
      --border: #24362f;
      --text: #e8f1ee;
      --muted: #9fb3ad;
      --accent: #7fd1ae;
      --accent-soft: #173229;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  /* On phones the header is not sticky, so anchors only need a small gap. */
  @media (max-width: 720px) {
    html {
      scroll-padding-top: 1rem;
    }
  }

  body {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
  }

  main {
    flex: 1;
  }

  a {
    color: var(--accent);
  }

  a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .container {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    border-radius: 6px;
    z-index: 100;
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .brand {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
  }

  .nav-list a {
    color: var(--muted);
    text-decoration: none;
  }

  .nav-list a:hover {
    color: var(--text);
  }

  nav {
    margin-left: auto;
  }

  .nav-cv {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  /* Below ~720px the name, seven links and CV no longer fit on one row, so
     the nav moves to its own row. The header also stops being sticky here:
     on a phone it would otherwise cover ~11% of the screen while reading. */
  @media (max-width: 720px) {
    .site-header {
      position: static;
    }

    .nav-cv {
      order: 1;
      margin-left: auto;
    }

    nav {
      order: 2;
      flex-basis: 100%;
      margin-left: 0;
    }

    .nav-list {
      gap: 0.25rem 0.8rem;
      font-size: 0.875rem;
    }
  }

  /* Touch screens (phones and tablets, any width): 44px-tall tap targets. */
  @media (pointer: coarse) {
    .header-inner {
      padding-top: 0.25rem;
      padding-bottom: 0.25rem;
    }

    .brand,
    .nav-cv,
    .nav-list a,
    .footer-links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    .nav-list {
      gap: 0 0.25rem;
      margin-left: -0.5rem;
    }

    .nav-list a {
      padding: 0 0.5rem;
    }

    .footer-links {
      gap: 0 1.25rem;
    }
  }

  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-note {
    flex-basis: 100%;
  }
</style>
